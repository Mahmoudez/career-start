# Public client configuration (safe for browser use)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only; use only inside /api serverless functions
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash
# Optional model chain (defaults to gemini-2.5-flash when omitted)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=
